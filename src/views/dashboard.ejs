<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">View All Users</a></p>
    <% } %>

    <h3>My Volunteer Projects</h3>

    <% if (volunteerProjects.length === 0) { %>

        <p>You have not volunteered for any projects.</p>

    <% } else { %>

        <ul>
            <% volunteerProjects.forEach(project => { %>

                <li>
                    <strong><%= project.title %></strong><br>

                    <%= project.location %><br>

                    <%= project.project_date %>

                    <form
                        action="/project/<%= project.project_id %>/remove-volunteer"
                        method="POST">

                        <button type="submit">
                            Remove Volunteer
                        </button>

                    </form>

                </li>

            <% }) %>
        </ul>

    <% } %>

</main>

<%- include('partials/footer') %>