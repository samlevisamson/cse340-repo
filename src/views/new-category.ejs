<%- include("partials/header") %>

<main>

    <h1>Create New Category</h1>

    <form action="/new-category" method="POST">

        <div>
            <label for="name">Category Name</label><br>

            <input
                type="text"
                id="name"
                name="name"
                required
                maxlength="100"
                value="<%= typeof name !== 'undefined' ? name : '' %>"
            >
        </div>

        <br>

        <button type="submit">
            Create Category
        </button>

    </form>

</main>

<%- include("partials/footer") %>