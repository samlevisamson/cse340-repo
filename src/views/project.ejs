<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>

    <p><strong>Description:</strong></p>
    <p><%= project.description %></p>

    <p>
        <strong>Date:</strong>
        <%= project.project_date %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= project.location %>
    </p>

    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <p>
    <strong>Categories:</strong>

    <% categories.forEach(category => { %>
        <a href="/category/<%= category.category_id %>">
            <%= category.name %>
        </a>
    <% }) %>
    </p>

    <p>
        <% if (user) { %>

            <% if (userIsVolunteer) { %>

                <strong>You are volunteering for this project.</strong>

                <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                    <button type="submit">Remove Volunteer</button>
                </form>

            <% } else { %>

                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit">Volunteer for this Project</button>
                </form>

            <% } %>

        <% } %>
    </p>

    <p>
        <% if (user && user.role_name === 'admin') { %>
            <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
        <% } %>
    </p>
    
    <p>
        <% if (user && user.role_name === 'admin') { %>
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
        <% } %>
    </p>
    
</main>

<%- include('partials/footer') %>